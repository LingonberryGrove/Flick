# Version control
.git
.gitignore
.dockerignore

# Dependencies (installed inside container)
node_modules
**/node_modules
.pnpm-store

# Build outputs (regenerated inside container)
apps/*/dist
apps/*/build

# Runtime data (server)
apps/server/posters
apps/server/backdrops

# Env files
.env
.env.local
.env.*.local
.env.test
.env.production

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode
.idea
*.swp

# Tests + coverage
coverage
apps/*/tests
apps/*/__tests__

# Docs
docs
*.md
!apps/*/README.md

# Docker configs
docker
docker-compose*.yml

# CI
.github