{
  "name": "@flick/server",
  "private": true,
  "description": "Backend API for Flick, built with Express and PostgreSQL.",
  "author": "Hans Nilsson",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm migrate:up && node --env-file=../../.env --watch src/server.js",
    "start": "node --env-file=../../.env src/server.js",
    "migrate:up": "node-pg-migrate --envPath ../../.env up",
    "migrate:down": "node-pg-migrate --envPath ../../.env down",
    "migrate:create": "node-pg-migrate --envPath ../../.env create --migration-file-language js",
    "test": "node-pg-migrate --envPath ../../.env.test up && node --env-file=../../.env.test --experimental-test-module-mocks --test --test-concurrency=1 tests/**/*.test.js",
    "lint": "eslint ./src || exit 0",
    "lint:fix": "eslint ./src --fix || exit 0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^62.9.0",
    "neostandard": "^0.13.0",
    "supertest": "^7.2.2"
  }
}
